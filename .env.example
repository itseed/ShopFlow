# ShopFlow Environment Variables
# Copy this file to .env.local and fill in your values

# ============================================
# Supabase Configuration
# ============================================
# For Supabase Cloud: Get these from your Supabase project settings
# For Supabase Local: Use the values from your local Supabase instance
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Service Role Key (for admin operations in CMS)
# WARNING: Never expose this key in client-side code!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================
# Application Configuration
# ============================================
NEXT_PUBLIC_APP_NAME=ShopFlow
NEXT_PUBLIC_APP_VERSION=1.0.0

# ============================================
# Database Configuration (for local Supabase)
# ============================================
# Only needed if using Supabase Local
POSTGRES_DB=shopflow
POSTGRES_USER=postgres
POSTGRES_PASSWORD=shopflow123
