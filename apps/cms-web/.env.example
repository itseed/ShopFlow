# CMS Web Application Environment Variables
# Copy this file to .env.local and fill in your values

# ============================================
# Supabase Configuration
# ============================================
# Get these from your Supabase project: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service Role Key (required for admin operations)
# Get this from Supabase project: Settings > API > service_role key
# WARNING: This key has admin privileges. Never commit it to version control!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================
# Application Configuration
# ============================================
NEXT_PUBLIC_APP_NAME=ShopFlow CMS
NEXT_PUBLIC_APP_VERSION=1.0.0

# ============================================
# Development Configuration
# ============================================
# Port for development server (default: 3001)
PORT=3001
